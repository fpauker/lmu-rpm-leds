Categories=Settings;HardwareSettings;
Keywords=MOZA;LED;RPM;sim racing;wheelbase;rev lights;telemetry;Le Mans Ultimate;LMU;
Keywords[de]=MOZA;LED;RPM;Sim Racing;Wheelbase;Schaltblitz;Drehzahl;Telemetrie;Lenkrad;Le Mans Ultimate;LMU;
